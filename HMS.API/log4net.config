<log4net>
	<root>
		<level value="DEBUG" />
		<appender-ref ref="LogFileAppender" />
		<appender-ref ref="EventLogAppender" />
		<appender-ref ref="ColoredConsoleAppender" />
	</root>
	<appender name="LogFileAppender" type="log4net.Appender.RollingFileAppender">
		<param name="File" value="Logs\\HSM-log-" />
		<param name="AppendToFile" value="true" />
		<encoding value="utf-8" />
		<rollingStyle value="Composite" />
		<maxSizeRollBackups value="2147483647" />
		<maximumFileSize value="100MB" />
		<staticLogFileName value="false" />
		<datePattern value="yyyyMMdd'.log'" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%5.5thread | %-80.90logger | %-38.50method | %-5line | %-10date | %-5level | %-20.40property{Operator} | %-16.18property{MachineIP} | %-30.40property{MachineName} | %message%newline" />
		</layout>
	</appender>
	<appender name="ColoredConsoleAppender" type="log4net.Appender.ColoredConsoleAppender">
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%5.5thread | %-80.90logger | %-38.50method | %-5line | %-10date | %-5level | %-20.40property{Operator} | %-16.18property{MachineIP} | %-30.40property{MachineName} | %message%newline" />
		</layout>
		<mapping>
			<level value="ERROR" />
			<foreColor value="White" />
			<backColor value="Red, HighIntensity" />
		</mapping>
		<mapping>
			<level value="DEBUG" />
			<backColor value="Green" />
		</mapping>
	</appender>
	<appender name="EventLogAppender" type="log4net.Appender.EventLogAppender">
		<param name="LogName" value="DUC Systems" />
		<param name="ApplicationName" value="Asp Net Core Maria DB" />
		<param name="Threshold" value="ERROR" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%4t %d{ABSOLUTE} %-5p %m%n" />
		</layout>
	</appender>
</log4net>